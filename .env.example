# AII — Environment Variables Reference
# Copy to .env.local for development. Never commit real values.

NEXT_PUBLIC_DATA_MODE=MOCK_ONLY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_AUTH_MOCK=true

# --- Production only (fill via platform Secret Manager) ---
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_NAME=
