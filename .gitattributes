# Normalize line endings across macOS / Windows.
# All text files are stored and checked out with LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp3 binary
*.wav binary
*.flac binary
*.ogg binary
*.mp4 binary
*.webm binary
*.glb binary
*.pdf binary
